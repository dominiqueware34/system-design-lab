# SpaceXAI (xAI) — get a key at https://console.x.ai
# Server-side only; never expose to the browser.
XAI_API_KEY=your_api_key_here

# Supabase Auth — Project Settings → API
# Public (safe in browser; RLS still required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Prefer publishable key (current Supabase docs). Anon key still works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_or_anon_key
# Alias for older tutorials / existing envs:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Server-only — never prefix with NEXT_PUBLIC_
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
